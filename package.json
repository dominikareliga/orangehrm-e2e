{
  "name": "orangehrm-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "UI automation for the OrangeHRM demo PIM module with Playwright",
  "scripts": {
    "test": "playwright test",
    "test:pim": "playwright test --grep @pim",
    "test:headed": "playwright test --headed --workers=1",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
